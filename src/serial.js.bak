'use strict';

const EventEmitter = require('events');

let SerialPort = null;
let serialLoadError = null;
try {
  // serialport@8：可选依赖，Linux 无串口头文件时可能编译失败
  SerialPort = require('serialport');
} catch (e) {
  serialLoadError = e;
  SerialPort = null;
}

/**
 * 串口封装：开/关、按 delimiter 切帧、emit('frame', string)
 * 无 serialport 原生模块时 open 返回明确错误，不崩溃
 */
class SerialBridge extends EventEmitter {
  constructor() {
    super();
    this._port = null;
    this._buf = Buffer.alloc(0);
    this._delimiter = Buffer.from('\r');
    this._opts = null;
  }

  get isOpen() {
    return !!(this._port && this._port.isOpen);
  }

  get available() {
    return !!SerialPort;
  }

  get loadError() {
    return serialLoadError;
  }

  /**
   * @param {object} opts { portName, baudRate, dataBits, parity, stopBits, delimiter }
   * @returns {Promise<void>}
   */
  open(opts) {
    return new Promise((resolve, reject) => {
      if (!SerialPort) {
        const msg =
          'serialport 模块不可用（原生编译失败或未安装）。请在 Windows 真机安装 Visual C++ Build Tools 后 npm install。' +
          (serialLoadError ? ' 原因: ' + serialLoadError.message : '');
        return reject(new Error(msg));
      }
      this.closeSync();
      this._opts = opts;
      const delim = opts.delimiter;
      if (Buffer.isBuffer(delim)) {
        this._delimiter = delim;
      } else if (typeof delim === 'string') {
        this._delimiter = Buffer.from(delim, 'utf8');
      } else {
        this._delimiter = Buffer.from('\r');
      }
      this._buf = Buffer.alloc(0);

      const port = new SerialPort(
        opts.portName,
        {
          baudRate: opts.baudRate || 9600,
          dataBits: opts.dataBits || 8,
          parity: opts.parity || 'none',
          stopBits: opts.stopBits || 1,
          autoOpen: false,
        },
        null
      );

      port.on('error', (err) => {
        this.emit('error', err);
      });

      port.on('data', (chunk) => {
        this._onData(chunk);
      });

      port.on('close', () => {
        this.emit('close');
      });

      port.open((err) => {
        if (err) {
          this._port = null;
          return reject(err);
        }
        this._port = port;
        resolve();
      });
    });
  }

  _onData(chunk) {
    this._buf = Buffer.concat([this._buf, chunk]);
    const d = this._delimiter;
    if (!d.length) return;
    let idx;
    while ((idx = this._buf.indexOf(d)) !== -1) {
      const frameBuf = this._buf.slice(0, idx);
      this._buf = this._buf.slice(idx + d.length);
      const frame = frameBuf.toString('utf8');
      this.emit('frame', frame);
    }
    // 防止异常超长缓冲
    if (this._buf.length > 64 * 1024) {
      this._buf = this._buf.slice(-1024);
    }
  }

  /** 同步尽力关闭（reload 时用） */
  closeSync() {
    if (this._port) {
      try {
        if (this._port.isOpen) this._port.close();
      } catch (e) {
        /* ignore */
      }
      this._port.removeAllListeners();
      this._port = null;
    }
    this._buf = Buffer.alloc(0);
  }

  close() {
    return new Promise((resolve) => {
      if (!this._port) return resolve();
      const p = this._port;
      this._port = null;
      this._buf = Buffer.alloc(0);
      if (!p.isOpen) {
        p.removeAllListeners();
        return resolve();
      }
      p.close(() => {
        p.removeAllListeners();
        resolve();
      });
    });
  }

  /**
   * 注入假数据帧（冒烟 / mock）
   * @param {string} frame
   */
  injectFrame(frame) {
    this.emit('frame', String(frame));
  }

  /**
   * 短时读若干帧（trial-read）
   * @param {object} opts 同 open，另可 timeoutMs、maxFrames
   * @returns {Promise<string[]>}
   */
  async readSamples(opts) {
    const timeoutMs = opts.timeoutMs != null ? opts.timeoutMs : 2000;
    const maxFrames = opts.maxFrames != null ? opts.maxFrames : 5;
    const reuse =
      this.isOpen &&
      this._opts &&
      this._opts.portName === opts.portName;

    let openedHere = false;
    if (!reuse) {
      await this.open(opts);
      openedHere = true;
    }

    return new Promise((resolve, reject) => {
      const samples = [];
      let done = false;
      const onFrame = (f) => {
        samples.push(f);
        if (samples.length >= maxFrames) finish();
      };
      const timer = setTimeout(() => finish(), timeoutMs);
      const finish = () => {
        if (done) return;
        done = true;
        clearTimeout(timer);
        this.removeListener('frame', onFrame);
        const cleanup = openedHere
          ? this.close()
          : Promise.resolve();
        cleanup.then(() => resolve(samples)).catch(reject);
      };
      this.on('frame', onFrame);
    });
  }
}

module.exports = { SerialBridge };
